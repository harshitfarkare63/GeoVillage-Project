# GeoVillage API — Backend Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
API_BASE_URL=http://localhost:4000

# ─────────────────────────────────────────────
# DATABASE (NeonDB PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/geovillage?sslmode=require"

# ─────────────────────────────────────────────
# REDIS (Upstash)
# ─────────────────────────────────────────────
REDIS_URL="redis://default:password@xxx.upstash.io:6379"
REDIS_TLS=true

# ─────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────
JWT_SECRET="your-256-bit-secret-change-in-production"
JWT_EXPIRY="3600"          # 1 hour in seconds
JWT_REFRESH_EXPIRY="604800" # 7 days in seconds

# ─────────────────────────────────────────────
# API KEYS
# ─────────────────────────────────────────────
API_KEY_PREFIX_LIVE="gva_live_"
API_KEY_PREFIX_TEST="gva_test_"
MASTER_ADMIN_KEY="gva_admin_changeme"

# ─────────────────────────────────────────────
# RATE LIMITING (requests per window)
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FREE=20
RATE_LIMIT_PREMIUM=200
RATE_LIMIT_PRO=1000

# ─────────────────────────────────────────────
# CACHING (TTL in seconds)
# ─────────────────────────────────────────────
CACHE_TTL_STATES=86400
CACHE_TTL_DISTRICTS=21600
CACHE_TTL_SUBDISTRICTS=21600
CACHE_TTL_VILLAGES=300
CACHE_TTL_SEARCH=120
CACHE_TTL_AUTOCOMPLETE=120
CACHE_TTL_APIKEY=600

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:5173,https://geovillage.in"
